---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeaderSimple from "@salient/ui/test_components/Header/HeaderSimple";
---

<BaseLayout title="Contact Us">
  <HeaderSimple 
    eyebrow="Start a Conversation"
    title="Get in touch"
    description="We work with a limited number of partners where our technical precision and economic logic can have the most impact."
    className="py-24 sm:py-32"
  />

  <div class="max-w-7xl mx-auto px-6 lg:px-8 pb-32">
    <div class="mx-auto max-w-2xl text-center">
      <div class="bg-gray-50 rounded-2xl p-12 border border-gray-100">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl mb-6">How to Reach Us</h2>
        <p class="text-lg text-gray-600 mb-10 text-pretty">
          The most effective way to begin is by describing your current executive context and the specific technical or economic friction you are facing.
        </p>
        <div class="flex items-center justify-center gap-x-6">
          <a 
            href="mailto:partner@auspinventures.com" 
            class="rounded-md bg-indigo-600 px-6 py-4 text-lg font-semibold text-white shadow-sm hover:bg-indigo-500 transition-colors"
          >
            Email the Partners →
          </a>
        </div>
      </div>

      <div class="mt-16 text-center">
        <p class="text-gray-500 text-sm italic">
          Note: We prioritize inquiries that demonstrate a readiness for practitioner-led execution rather than general advisory.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
