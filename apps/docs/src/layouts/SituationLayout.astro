---
import BaseLayout from './BaseLayout.astro';
import HeaderSimple from "@salient/ui/test_components/Header/HeaderSimple";
const { frontmatter } = Astro.props;
---
<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <header class="bg-white">
    <HeaderSimple 
      eyebrow="Situation" 
      title={frontmatter.title} 
      description={frontmatter.description}
      className="py-16 sm:py-24"
    />
  </header>
  <article class="max-w-7xl mx-auto px-6 pb-24 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <div class="prose prose-indigo lg:prose-xl">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style is:global>
  /* Basic prose-like styles if tailwind-typography is not available or to keep it simple */
  .prose h2 {
    @apply text-2xl font-bold text-gray-900 mt-12 mb-4;
  }
  .prose p {
    @apply text-lg text-gray-600 leading-8 mb-6 text-pretty;
  }
  .prose ul {
    @apply list-disc list-inside mb-6 space-y-2 text-gray-600;
  }
  .prose li {
    @apply text-lg leading-8;
  }
  .prose a {
    @apply font-semibold text-indigo-600 hover:text-indigo-500;
  }
</style>
