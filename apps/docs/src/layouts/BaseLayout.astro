---
import NavbarWithCenteredLogo from "@salient/ui/test_components/Navbar/NavbarWithCenteredLogo";
import { Footer } from "@salient/ui";

const { FooterSimple } = Footer;

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const logo = {
  src: "/logo.svg",
  alt: "AUSPIN Ventures",
  href: "/"
};

const navigation = [
  { name: "Situations", href: "/situations" },
  { name: "Thinking", href: "/thinking" },
  { name: "Engagement", href: "/engagement" },
  { name: "Team", href: "/team" },
  { name: "Contact", href: "/contact" },
];

const action = {
  label: "Engagement",
  href: "/engagement"
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | AUSPIN Ventures</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:global>
      @tailwind base;
      @tailwind components;
      @tailwind utilities;

      .text-balance {
        text-wrap: balance;
      }
      .text-pretty {
        text-wrap: pretty;
      }
    </style>
  </head>
  <body class="antialiased bg-white text-gray-900">
    <NavbarWithCenteredLogo 
      client:load 
      logo={logo} 
      navigation={navigation} 
      action={action}
    />

    <main class="min-h-screen">
      <slot />
    </main>

    <FooterSimple />
  </body>
</html>
